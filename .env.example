# ==============================================================================
# Smart Contract Dev Pipeline 2.0 - Environment Variables
# ==============================================================================
# Fichier: .env.example
# Description: Template des variables d'environnement.
#              Copier vers .env et configurer.
# ==============================================================================

# ==============================================================================
# GITHUB
# ==============================================================================
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_USERNAME=octocat
GITHUB_REPO=smart-contract-pipeline

# ==============================================================================
# BLOCKCHAIN
# ==============================================================================
ETH_RPC_URL=http://127.0.0.1:8545
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
CHAIN_ID=313133

# ==============================================================================
# BASE DE DONNÉES
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://pipeline:pipeline@localhost:5432/pipeline
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ==============================================================================
# REDIS
# ==============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# ==============================================================================
# LLM / OLLAMA
# ==============================================================================
OLLAMA_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=deepseek-coder:6.7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1

# ==============================================================================
# CHROMADB
# ==============================================================================
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=web3_docs

# ==============================================================================
# PIPELINE
# ==============================================================================
MAX_AUTO_DEBUG_RETRIES=3
VERIFICATION_TIMEOUT=300
HALMOS_MAX_DEPTH=10
WORKSPACE_PATH=./workspace
LOG_LEVEL=INFO

# ==============================================================================
# API
# ==============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_CORS_ORIGINS=*

# ==============================================================================
# CLÉS API EXTERNES
# ==============================================================================
INFURA_API_KEY=
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
COINMARKETCAP_API_KEY=

# ==============================================================================
# TEST / DEBUG
# ==============================================================================
DEBUG=false
TEST_MODE=false
MOCK_LLM=false
MOCK_BLOCKCHAIN=false# ==============================================================================
# Smart Contract Dev Pipeline 2.0 - Environment Variables Template
# ==============================================================================

# URL du nœud RPC Ethereum (Anvil en local, ou Infura/Alchemy pour les testnets)
ETH_RPC_URL=http://127.0.0.1:8545

# Chain ID du réseau cible (313133 pour Anvil, 11155111 pour Sepolia)
CHAIN_ID=313133

# Clé privée du compte de déploiement (SANS le préfixe 0x)
# ⚠️ NE JAMAIS COMMITTER LE FICHIER .env RÉEL CONTENANT VOTRE VRAIE CLÉ PRIVÉE
PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Clé API Etherscan (optionnel, pour la vérification des contrats sur testnet/mainnet)
ETHERSCAN_API_KEY=your_etherscan_api_key_here