# ==============================================================================
# Smart Contract Dev Pipeline 2.0 - Environment Variables Template
# ==============================================================================

# URL du nœud RPC Ethereum (Anvil en local, ou Infura/Alchemy pour les testnets)
ETH_RPC_URL=http://127.0.0.1:8545

# Chain ID du réseau cible (313133 pour Anvil, 11155111 pour Sepolia)
CHAIN_ID=313133

# Clé privée du compte de déploiement (SANS le préfixe 0x)
# ⚠️ NE JAMAIS COMMITTER LE FICHIER .env RÉEL CONTENANT VOTRE VRAIE CLÉ PRIVÉE
PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Clé API Etherscan (optionnel, pour la vérification des contrats sur testnet/mainnet)
ETHERSCAN_API_KEY=your_etherscan_api_key_here